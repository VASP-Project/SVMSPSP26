{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "module": "esnext",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "target": "es6",
    //"strict": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "@app/*": ["app/*"],
      "@helpers/*": [
          "src/app/_helpers/*"
      ],
       "@modules/*": [
           "modules/*"
      ],
      "@src/app/*": [
        "../src/app/*"
      ],
  },
  },
  "include": [
    "**/*",
    "node_modules/@angular/*"
  ]
 
}
